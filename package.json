{
  "name": "tasra-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "copy:pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "setup": "node --import tsx server/setup.ts",
    "serve": "node --import tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run typecheck && npm run build:web",
    "fund-slot": "node --import tsx server/fund-slot.ts",
    "verify": "node --import tsx server/verify.ts",
    "test": "node --import tsx --test server/workflow.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "@noble/curves": "^1.9.7",
    "hono": "^4.6.14",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tasra-sdk": "^0.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
